{
  "name": "todolist-app",
  "version": "5.1.0",
  "description": "Application To-Do List Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . ToDoList --platform=win32 --arch=x64 --out=release --overwrite --icon=assets/icons/icon.ico --prune=true",
    "installer": "electron-builder --win nsis",
    "build:all": "npm run package && npm run installer"
  },
  "build": {
    "appId": "com.todolist.app",
    "productName": "To-Do List",
    "copyright": "Copyright © 2026 Sacha G.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "!build/**/*",
      "!release/**/*",
      "!versions/**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "To-Do List",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "runAfterFinish": true
    }
  },
  "author": "Sacha G.",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
